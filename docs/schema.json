  "components": {
    "schemas": {
      "EventDefinition": {
        "type": "object",
        "description": "One registry entry, in the shape ``events.json`` uses.",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "props": {
            "type": "object",
            "additionalProperties": {}
          },
          "flow": {
            "type": "string",
            "nullable": true
          },
          "builtin": {
            "type": "boolean"
          }
        },
        "required": [
          "name"
        ]
      },
      "EventRegistry": {
        "type": "object",
        "description": "The vocabulary this deployment admits, plus how it enforces it.",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EventDefinition"
            }
          },
          "mode": {
            "type": "string"
          },
          "adapters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bridged_actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "EventsReport": {
        "type": "object",
        "description": "Counts grouped by a payload field over a period — the dashboard's\ncheap half (``store.rollup``).",
        "properties": {
          "buckets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RollupBucket"
            }
          },
          "total": {
            "type": "integer"
          },
          "group_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "FunnelCreate": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[-a-zA-Z0-9_]+$"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            }
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string"
          },
          "window_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "is_active": {
            "type": "boolean",
            "default": true
          },
          "workspace_id": {
            "type": "string",
            "format": "uuid",
            "nullable": true
          }
        },
        "required": [
          "slug",
          "steps"
        ]
      },
      "FunnelDefinition": {
        "type": "object",
        "description": "A funnel as the API presents it.",
        "properties": {
          "slug": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "window_seconds": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "is_active": {
            "type": "boolean"
          },
          "id": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "slug"
        ]
      },
      "FunnelPresenterDTO": {
        "type": "object",
        "description": "Presents an authored funnel row.",
        "properties": {
          "slug": {
            "type": "string",
            "description": "slug"
          },
          "title": {
            "type": "string",
            "description": "title"
          },
          "description": {
            "type": "string",
            "description": "description"
          },
          "window_seconds": {
            "type": "integer",
            "description": "window seconds"
          },
          "is_active": {
            "type": "boolean",
            "description": "is active"
          },
          "id": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {},
            "description": "Ordered event names a subject must pass through."
          },
          "source": {
            "type": "string",
            "description": "'db' (authored here) or 'settings' (declared in the project spec and read-only over the API)."
          }
        },
        "required": [
          "description",
          "id",
          "is_active",
          "slug",
          "source",
          "steps",
          "title",
          "window_seconds"
        ]
      },
      "FunnelReportDTO": {
        "type": "object",
        "description": "Conversion by step over a period, optionally versus the one before.",
        "properties": {
          "slug": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FunnelStep"
            }
          },
          "entered": {
            "type": "integer"
          },
          "completed": {
            "type": "integer"
          },
          "conversion": {
            "type": "number",
            "format": "double"
          },
          "window_seconds": {
            "type": "integer"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "compare_start": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "compare_end": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "scanned": {
            "type": "integer"
          },
          "truncated": {
            "type": "boolean"
          }
        },
        "required": [
          "slug"
        ]
      },
      "FunnelStep": {
        "type": "object",
        "description": "One step of a computed report.",
        "properties": {
          "name": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          },
          "rate_from_first": {
            "type": "number",
            "format": "double"
          },
          "rate_from_previous": {
            "type": "number",
            "format": "double"
          },
          "dropoff": {
            "type": "integer"
          },
          "previous_count": {
            "type": "integer",
            "nullable": true
          },
          "delta": {
            "type": "integer",
            "nullable": true
          }
        },
        "required": [
          "count",
          "dropoff",
          "name",
          "rate_from_first",
          "rate_from_previous"
        ]
      },
      "Ingest": {
        "type": "object",
        "description": "The batch, as ``@stapel/analytics`` and the native collector send it.\n\n``write_key`` is optional because the shipped facade omits it unless a\nhost configured one; ``anon_id`` / ``session_id`` are batch-level\ndefaults the current facade does not send at all and a server-side\nproducer does; ``context`` describes the emitter. See ``ingest.py`` for\nthe whole wire contract.",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IngestEvent"
            }
          },
          "write_key": {
            "type": "string"
          },
          "anon_id": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "context": {
            "$ref": "#/components/schemas/IngestContext"
          }
        },
        "required": [
          "events"
        ]
      },
      "IngestContext": {
        "type": "object",
        "description": "The emitter of a batch, copied onto every stored event.",
        "properties": {
          "platform": {
            "type": "string",
            "description": "ios, android, desktop, web"
          },
          "app_version": {
            "type": "string"
          },
          "os_version": {
            "type": "string"
          },
          "locale": {
            "type": "string",
            "description": "BCP 47 tag, e.g. en-US"
          },
          "sdk": {
            "type": "string",
            "description": "Collector name and version"
          }
        }
      },
      "IngestEvent": {
        "type": "object",
        "description": "One event of a batch, in the facade's spelling.\n\nThe collector also reads the snake_case spellings (``user_hash``,\n``event_id``) and ``timestamp``/``traits`` aliases; this is the shape a\ngenerated client sends. Faults are reported per event in the receipt,\nnever by refusing the batch.",
        "properties": {
          "id": {
            "type": "string",
            "description": "Client event id, echoed into the store as event_id."
          },
          "kind": {
            "allOf": [
              {
                "$ref": "#/components/schemas/KindEnum"
              }
            ],
            "default": "track"
          },
          "name": {
            "type": "string",
            "description": "Event name; a registered one for kind=track."
          },
          "props": {
            "type": "object",
            "additionalProperties": {},
            "description": "Event properties (PII-guarded)."
          },
          "userHash": {
            "type": "string",
            "description": "sha256 hex of the account id, after identify()."
          },
          "ts": {
            "type": "integer",
            "description": "Epoch milliseconds; server time when absent."
          },
          "anon_id": {
            "type": "string",
            "description": "Overrides the batch anon_id."
          },
          "session_id": {
            "type": "string",
            "description": "Overrides the batch session_id."
          },
          "source": {
            "type": "string",
            "description": "Overrides the batch source."
          }
        }
      },
      "IngestReceipt": {
        "type": "object",
        "description": "What the ingest endpoint answers.\n\n``rejected`` is a LIST OF REASONS, not a count: a collector that learns\n\"3 of 20 refused\" and not why has no way to stop sending the same three\nforever, and the facade's retry ladder guarantees it will.",
        "properties": {
          "accepted": {
            "type": "integer"
          },
          "rejected": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": {}
            }
          },
          "unregistered": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "accepted"
        ]
      },
      "KindEnum": {
        "enum": [
          "track",
          "page",
          "identify"
        ],
        "type": "string",
        "description": "* `track` - track\n* `page` - page\n* `identify` - identify"
      },
      "PatchedFunnelPatch": {
        "type": "object",
        "properties": {
          "steps": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            }
          },
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "description": {
            "type": "string"
          },
          "window_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "RollupBucket": {
        "type": "object",
        "description": "One group-by bucket of the events report.",
        "properties": {
          "group": {
            "type": "object",
            "additionalProperties": {}
          },
          "count": {
            "type": "integer"
          }
        },
        "required": [
          "count",
          "group"
        ]
      }
    },
    "securitySchemes": {
      "JWTCookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "stapel_jwt",
        "description": "JWT token stored in cookie. Login via /auth/admin/ to get the cookie."
      }
    }
  }
}
